# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Scanning ──────────────────────────────────────────────────────────────
SCAN_INTERVAL_MINUTES=15
DEFAULT_ZIP=27330

# ── Browser ───────────────────────────────────────────────────────────────
HEADLESS=true

# ── Proxy (Phase 5) ───────────────────────────────────────────────────────
# Uncomment and fill in to route all browser traffic through a proxy.
# Supports HTTP, SOCKS5. Leave blank / commented out to disable.
# PROXY_URL=http://user:pass@proxyhost:8080
# PROXY_URL=socks5://user:pass@proxyhost:1080

# ── Paths (rarely need changing) ─────────────────────────────────────────
SESSION_FILE=data/fb_session.json
DB_PATH=data/marketplace.db
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
