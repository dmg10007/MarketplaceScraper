# ============================================================
# MarketplaceScraper — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.
# ============================================================

# --- Facebook Bot Account ---
FB_EMAIL=your_bot_account@email.com
FB_PASSWORD=your_bot_password

# --- Telegram ---
# Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram
# Get TELEGRAM_CHAT_ID by messaging @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=987654321

# --- Scraper Behaviour ---
# How often to run all searches (minutes). Recommended: 10-30
SCAN_INTERVAL_MINUTES=15

# Random delay between page requests (seconds). Reduces bot detection.
REQUEST_DELAY_MIN=2.0
REQUEST_DELAY_MAX=8.0

# Max parallel searches (1-10)
MAX_CONCURRENT_SEARCHES=5

# False = visible browser window (stealthier on Windows). True = headless.
HEADLESS=false

# Path to saved browser session (cookies). Keep this out of git.
SESSION_FILE=data/fb_session.json

# --- Proxy (optional) ---
# Leave blank to use your home IP. Add only if you get blocked.
# Format: http://username:password@host:port
PROXY_URL=

# --- Web Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Change this to a random string in production
DASHBOARD_SECRET_KEY=change-me-to-a-random-string

# --- Health Monitoring ---
# Alert via Telegram if no successful scrape run in this many minutes
HEALTH_ALERT_THRESHOLD_MINUTES=90
